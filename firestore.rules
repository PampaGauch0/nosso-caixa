rules_version = '2';
service cloud.firestore {
  match /databases/{database}/documents {
    // Administrador fixo: só ele adiciona ou remove pessoas autorizadas.
    function dono() { return 'alison.vieira.silva@hotmail.com'; }
    function logado() { return request.auth != null && request.auth.token.email_verified == true; }
    function email() { return request.auth.token.email.lower(); }
    function ehDono() { return logado() && email() == dono(); }
    function caminhoAcesso() { return /databases/$(database)/documents/acesso/membros; }
    // Membro = administrador ou e-mail presente em acesso/membros.emails
    function ehMembro() {
      return logado() && (email() == dono()
        || (exists(caminhoAcesso()) && email() in get(caminhoAcesso()).data.emails));
    }

    match /acesso/membros {
      allow read: if ehMembro();
      allow create, update: if ehDono()
        && request.resource.data.keys().hasOnly(['dono', 'emails'])
        && request.resource.data.dono == dono()
        && request.resource.data.emails is list
        && request.resource.data.emails.size() <= 10
        && dono() in request.resource.data.emails;
      allow delete: if false;
    }
    match /config/{id}      { allow read, write: if ehMembro(); }
    match /lancamentos/{id} { allow read, write: if ehMembro(); }
    match /metas/{id}       { allow read, write: if ehMembro(); }
    // Qualquer outro caminho fica bloqueado.
  }
}
